# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Орчны хувьсагчдын загвар.
#
# Хэрэглээ: энэ файлыг хуулж `.env` нэртэй болгоод утгуудыг бөглөнө.
# `.env` файл git-д орохгүй (.gitignore-д бүртгэлтэй). Утга өөрчилсний дараа
# `npm run dev`-ийг зогсоож дахин ажиллуулна.
# ─────────────────────────────────────────────────────────────────────────────

# Ирээдүйн МҮХАҮТ backend API-ийн хаяг. Backend бэлэн болтол хоосон үлдээнэ.
VITE_API_BASE_URL=
# Жинхэнэ веб аппын хаяг ("Нэвтрэх" товчлуурт ашиглагдана).
VITE_APP_URL=

# --- Хүсэлт илгээх маягт → имэйл ---------------------------------------------
# 1-р сонголт (зөвлөж байна): Web3Forms — https://web3forms.com (үнэгүй)
#   1) Сайт руу орж хүсэлт хүлээн авах имэйл хаягаа оруулна
#   2) Тэр имэйл рүү ирсэн "Access Key"-г доор буулгана
#   Маягтаар илгээсэн бүх хүсэлт тэр имэйл рүү очно.
VITE_WEB3FORMS_KEY=
# 2-р сонголт: Formspree — https://formspree.io (зөвхөн form id, жишээ нь xayzabcd)
VITE_FORMSPREE_ID=
# Аль нь ч тохируулаагүй бол маягт зочны имэйл программыг бэлэн бөглөсөн байдлаар нээнэ.
