# Copy this file to `.env` and fill in the values. `.env` is not committed to git.

# Base URL of the future МҮХАҮТ backend API. Leave empty until the backend exists.
VITE_API_BASE_URL=
# Public URL of the web application (used for the "Нэвтрэх" links once the app is live).
VITE_APP_URL=

# --- Contact / partnership form → email -------------------------------------
# Option 1 (recommended): Web3Forms — https://web3forms.com
#   Enter the email address that should receive requests; they email you an access key.
VITE_WEB3FORMS_KEY=
# Option 2: Formspree — https://formspree.io  (paste only the form id, e.g. xayzabcd)
VITE_FORMSPREE_ID=
# With neither set, the form opens the visitor's email app pre-filled instead.
